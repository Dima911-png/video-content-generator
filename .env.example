# =============================================================================
# YouTube Video Automation - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control!

# =============================================================================
# Required API Keys
# =============================================================================

# OpenAI API Key (for script generation)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ElevenLabs API Key (for voice generation)
# Get yours at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# =============================================================================
# Optional: Image Search APIs (improves image quality)
# =============================================================================

# Pexels API Key
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# Pixabay API Key
# Get yours at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your-pixabay-api-key-here

# =============================================================================
# Optional: Custom API URLs (uncomment if needed)
# =============================================================================
# OPENAI_API_URL=https://api.openai.com/v1
# ELEVENLABS_API_URL=https://api.elevenlabs.io/v1
